{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["knowledge/**/*.ts", "tests/**/*.ts"]
}
